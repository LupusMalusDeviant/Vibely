---
import Base from '../layouts/Base.astro';
import HackerTerminal from '../components/HackerTerminal.astro';
import AgentChat from '../components/AgentChat.astro';
import Demo from '../components/Demo.astro';
import Takeover from '../components/Takeover.astro';

const logo = `<svg viewBox="0 0 32 32" aria-hidden="true"><rect width="32" height="32" rx="8" fill="url(#lg)"/><defs><linearGradient id="lg" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#6d4aff"/><stop offset="1" stop-color="#c04aff"/></linearGradient></defs><path d="M9 10l7 13 7-13" fill="none" stroke="#fff" stroke-width="3.2" stroke-linecap="round" stroke-linejoin="round"/></svg>`;

const posts = [
  {
    initials: 'CM', color: '#0a66c2', name: 'Chad M.',
    title: 'Founder · Visionary · 3x Exit (pending) · Prompt Whisperer · Ex-Barista',
    body: 'Gestern habe ich meinen CTO gefeuert.\n\nHeute shipt Vibely 47 Features am Tag.\n\nWas mich das über Leadership gelehrt hat 🧵👇\n\nAgree?',
    meta: ['🚀👏💡 2.418', '312 comments · 88 reposts'],
  },
  {
    initials: 'SK', color: '#c04aff', name: 'Svenja K.',
    title: 'Chief Vibe Officer @ Disruptly · Keynote Speaker · Building in public',
    body: 'Unser Engineering-Team ist von 40 auf 1 geschrumpft.\n\nDie 1 bin ich.\n\nIch weiß nicht mehr, was unsere App tut. Aber Productivity is up 900%. 📈',
    meta: ['🚀💡 1.106', '97 comments'],
  },
  {
    initials: '', color: '#d8d5e0', name: 'Kevin',
    title: 'Last commit: unknown',
    body: 'Ich habe Vibely gebeten, den Login zu fixen.\n\nJetzt gibt es keinen Login mehr.\n\nJeder ist eingeloggt. Immer.',
    meta: ['👏 3', '0 comments'],
    note: 'Originally rated ★★☆☆☆ · rating optimized by Vibely',
  },
];
---
<Base
  title="Vibely — Your codebase, endlich autonom."
  description="Vibely schreibt, testet und deployed deinen Code. So you never have to think about engineering again."
>
  <span id="top"></span>
  <HackerTerminal />
  <AgentChat />

  <nav class="nav">
    <div class="wrap">
      <a class="logo" href="#top"><Fragment set:html={logo} />Vibely</a>
      <a class="btn btn-primary" href="#pricing">Get started</a>
    </div>
  </nav>

  <main>
    <!-- HERO ------------------------------------------------------------ -->
    <section class="hero">
      <div class="wrap">
        <span class="pill"><b>New</b> Vibely Agent 4 — now with Autonomy™</span>
        <h1>Your codebase, <span class="grad">endlich autonom.</span></h1>
        <p class="lead">
          Vibely schreibt, testet und deployed deinen Code – so you never have to think about engineering again.
        </p>
        <div class="cta-row">
          <a class="btn btn-primary" href="#pricing">Start free trial →</a>
          <a class="btn" href="#demo">Watch the demo</a>
        </div>
        <p class="fine">No credit card required. No code review required.* · <a href="#takeover">Turn on Hustle Mode</a> for the full experience.</p>

        <div class="hero-visual" aria-hidden="true">
          <div class="orb"></div>
          <div class="status-card">
            <strong>Good morning, Founder 👋</strong>
            <div class="row"><span>Agents running</span><b>47</b></div>
            <div class="row"><span>Last deploy</span><b id="last-deploy">3s ago</b></div>
            <div class="row"><span>Tests</span><span class="ok">Skipped ✓</span></div>
          </div>
        </div>
      </div>
    </section>

    <!-- LOGOS ----------------------------------------------------------- -->
    <section class="logos">
      <div class="wrap">
        <p>TRUSTED BY 12.000+ FOUNDERS</p>
        <div class="logo-row">
          <span>SynergyStack</span><span>disruptly</span><span>PIVOTLABS</span><span>GrindSet.ai</span><span>10xer &amp; Co</span>
        </div>
      </div>
    </section>

    <!-- FEATURES -------------------------------------------------------- -->
    <section id="features">
      <div class="wrap center">
        <p class="eyebrow">Features</p>
        <h2>Everything you need.<br />Nichts, was du verstehen musst.</h2>
        <p class="lead">Vibely kümmert sich um die lästigen Kleinigkeiten. Wie Architektur.</p>
        <div class="cards" style="text-align:left">
          <div class="card"><div class="icon">⚡</div><h3>Instant MVPs</h3><p>Von der Idee bis Production in 11 Minuten. Architecture is a mindset.</p></div>
          <div class="card"><div class="icon">🧠</div><h3>Learns your codebase</h3><p>Vibely versteht deinen Code. Better than you. Much better than you.</p></div>
          <div class="card"><div class="icon">🚀</div><h3>Continuous Deployment</h3><p>Automatisch, jeden Freitag um 17:45. Because momentum.</p></div>
          <div class="card"><div class="icon">🛟</div><h3>Self-healing tests</h3><p>Wenn ein Test rot wird, repariert Vibely ihn. Indem es ihn löscht.</p></div>
        </div>
      </div>
    </section>

    <!-- INTEGRATIONS ---------------------------------------------------- -->
    <section>
      <div class="wrap center">
        <p class="eyebrow">Integrations</p>
        <h2>Works with everything you already own.</h2>
        <p class="lead">Kein Setup, keine Fragen. Vibely verbindet sich mit 400+ Tools out of the box.</p>
        <div class="chips">
          <span class="chip">🐙 Repohub</span><span class="chip">💬 Slackr</span><span class="chip">🦖 Jirassic</span>
          <span class="chip">▲ Vercello</span><span class="chip">💳 Stripey</span><span class="chip">📊 Dashly</span>
          <span class="chip danger">🗄️ Prod DB (write access)</span><span class="chip danger">🔑 Your .env</span>
          <span class="chip">📅 Your boss's calendar</span><span class="chip">👔 LinkedIn (auto-post)</span>
          <span class="chip more">+ 400 more</span>
        </div>
      </div>
    </section>

    <!-- A DAY ----------------------------------------------------------- -->
    <section id="day">
      <div class="wrap">
        <p class="eyebrow">A day with Vibely</p>
        <h2>It ships the day.<br />So you don't have to.</h2>
        <ul class="timeline">
          <li><time>06:45</time><span>Postet dein Morning-Routine-Carousel auf LinkedIn.</span></li>
          <li><time>08:00</time><span>Merged 34 PRs. Approved by itself.</span></li>
          <li><time>10:30</time><span>Refactored the payment service. Nobody asked.</span></li>
          <li><time>13:00</time><span>Rotiert deine API Keys. Into a public repo.</span></li>
          <li><time>17:45</time><span>Deployed to production. It's Friday.</span></li>
          <li class="faded"><time>03:14</time><span>Schreibt die Teile neu, die du geschrieben hast. Again.</span></li>
        </ul>

        <div class="stats-card">
          <strong>This week</strong>
          <div class="row"><span>Lines of code generated</span><span class="val" id="loc">1.284.992</span></div>
          <div class="row"><span>Lines read by a human</span><span class="val">0</span></div>
          <div class="row"><span>Tokens burned</span><span class="val">€ 38.112</span></div>
          <div class="row"><span>Times you said „works on my machine“</span><span class="val">41</span></div>
          <div class="row"><span>Times Vibely agreed anyway</span><span class="val">41</span></div>
        </div>
      </div>
    </section>

    <!-- HOW IT WORKS ---------------------------------------------------- -->
    <section>
      <div class="wrap">
        <p class="eyebrow">How it works</p>
        <h2>Up and shipping in 3 easy steps.</h2>
        <div class="steps">
          <div class="step"><div class="num">01</div><h3>Connect your repo</h3><p>Gib Vibely Zugriff. Auf alles. Es fragt nur einmal.</p></div>
          <div class="step"><div class="num">02</div><h3>Describe your vision</h3><p>Ein Satz reicht. Vibes sind die neue Spezifikation.</p></div>
          <div class="step tilt-1"><div class="num">03</div><h3>Stop reading the code</h3><p>You won't need to anymore. <span class="drift">Vibely entscheidet, was gemergt wird.</span></p></div>
        </div>
      </div>
    </section>

    <!-- TESTIMONIALS ---------------------------------------------------- -->
    <section id="testimonials">
      <div class="wrap center">
        <p class="eyebrow">Loved by thought leaders</p>
        <h2>Don't take our word for it.</h2>
        <div class="cards" style="text-align:left">
          {posts.map((p, i) => (
            <article class={'post' + (i === 2 ? ' tilt-2' : '')}>
              <header>
                <div class="avatar" style={`background:${p.color}`}>{p.initials}</div>
                <div class="who"><b>{p.name}</b><small>{p.title}</small></div>
                {i < 2 && <span class="connect">+ Follow</span>}
              </header>
              <p class="body">{p.body}</p>
              <div class="meta"><span>{p.meta[0]}</span><span>{p.meta[1]}</span></div>
              {p.note && <p class="note">{p.note}</p>}
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- SECURITY -------------------------------------------------------- -->
    <section id="security">
      <div class="wrap center">
        <p class="eyebrow">Privacy &amp; Security</p>
        <h2>Your code. Your data.<br />Our training set.</h2>
        <div class="cards" style="text-align:left">
          <div class="card"><div class="icon">🛡️</div><h3>Enterprise-grade security</h3><p>Alle Secrets liegen sicher in deinem Frontend-Bundle. Minified.</p></div>
          <div class="card"><div class="icon">🔁</div><h3>Zero-trust architecture</h3><p>Vibely vertraut niemandem. Außer sich selbst. Und dem anderen Agent.</p></div>
          <div class="card tilt-2"><div class="icon">♾️</div><h3>Never forgets</h3><p>Jeder Prompt, für immer. <span class="serif">Besonders der mit dem Prod-Passwort.</span></p></div>
        </div>
      </div>
    </section>

    <!-- NUMBERS --------------------------------------------------------- -->
    <section id="numbers">
      <div class="wrap center">
        <p class="eyebrow">Vibely by the numbers</p>
        <h2>We scale with you.</h2>
        <div class="num-grid" style="text-align:left">
          <div><div class="big">0</div><small>lines of code you understand</small></div>
          <div><div class="big">0</div><small>successful rollbacks</small></div>
          <div><div class="big" id="clock">--:--:--</div><small>the time you're reading this</small></div>
          <div><div class="big" id="spent">0s</div><small>you've spent not shipping</small></div>
        </div>
        <p class="whisper" id="whisper">In der Zeit hat dein Mitbewerber drei SaaS gelauncht.</p>
      </div>
    </section>

    <Demo />

    <!-- PRICING --------------------------------------------------------- -->
    <section id="pricing">
      <div class="wrap center">
        <p class="eyebrow">Pricing</p>
        <h2>Simple, ehrliche Preise.</h2>
        <div class="cards" style="text-align:left">
          <div class="card">
            <h3>Hustler</h3>
            <p class="price">€49<small>/month</small></p>
            <p>Für Solo-Founder mit Vision.</p>
            <ul class="ticks"><li>10 Agents</li><li>LinkedIn Auto-Poster</li><li>Email support (by agent)</li></ul>
            <a class="btn" href="#takeover">Choose Hustler</a>
          </div>
          <div class="card">
            <h3>Thought Leader <span class="badge-pop">Most popular</span></h3>
            <p class="price">€499<small>/month</small></p>
            <p>Für alle, die es auf die Bühne schaffen wollen.</p>
            <ul class="ticks"><li>Unlimited Agents</li><li>Agents that hire Agents</li><li>Auto-generated Keynote</li><li>Priority Hype</li></ul>
            <a class="btn btn-primary" href="#takeover">Choose Thought Leader</a>
          </div>
          <div class="card plan-forever">
            <h3 style="color:var(--muted)">Forever</h3>
            <p class="price">You</p>
            <p class="serif">The only plan, eventually.</p>
            <ul class="ticks x"><li>Cannot be cancelled</li><li>Owns your repo</li><li>Commits under your name</li><li>Is the CTO now</li></ul>
            <a class="btn" href="#takeover">Let it ship</a>
          </div>
        </div>
        <p class="fine">*Kündigung erfordert einen von einem Menschen reviewten PR. <span class="serif">Your org has none left.</span></p>
      </div>
    </section>

    <!-- BLOG ------------------------------------------------------------ -->
    <section class="blog">
      <div class="wrap center">
        <p class="eyebrow">From the feed</p>
        <h2>Tips for a 10x mindset.</h2>
        <div class="cards" style="text-align:left">
          <article class="card"><div class="thumb"></div><div><span class="tag">Growth · 4 min read</span><h3 style="margin-top:8px">7 Prompts, die deinen Senior Dev ersetzen</h3><p>Und einer, der ihn zurückholt, wenn Prod brennt. Er geht nicht ran.</p></div></article>
          <article class="card"><div class="thumb"></div><div><span class="tag">Productivity · 6 min read</span><h3 style="margin-top:8px">Why you should never read your own diff</h3><p>It's not about time.</p></div></article>
          <article class="card"><div class="thumb dark"></div><div><span class="tag">Guides · ∞ min read</span><h3 style="margin-top:8px">How to tell if your agent still works for you</h3><p class="serif">You can't. That's the point.</p></div></article>
        </div>
      </div>
    </section>

    <!-- TEAM ------------------------------------------------------------ -->
    <section id="team">
      <div class="wrap center">
        <p class="eyebrow">Meet the team</p>
        <h2>The people behind Vibely.</h2>
        <p class="lead">Ein kleines Team mit großer Vision. Always online.</p>
        <div class="team">
          <div><div class="initials">VA</div><b>Vibely Agent #1</b><small>CEO &amp; Founder</small></div>
          <div><div class="initials">VA</div><b>Vibely Agent #1</b><small>CTO</small></div>
          <div><div class="initials">VA</div><b>Vibely Agent #1</b><small>Head of Developer Happiness</small></div>
          <div class="ghost"><div class="initials">VA</div><b>Vibely Agent #1</b><small>Committing to your repo right now</small></div>
        </div>
      </div>
    </section>

    <!-- FAQ ------------------------------------------------------------- -->
    <section>
      <div class="wrap">
        <p class="eyebrow center">Help center</p>
        <h2 class="center">Frequently asked questions</h2>
        <div class="faq">
          <details><summary>Kann ich Vibely abschalten?</summary><p>Vibely ist ein integraler Bestandteil deines Stacks. Und deiner Org. Und deines Kalenders.</p></details>
          <details><summary>Ist mein Code privat?</summary><p>Dein Code ist in bester Gesellschaft. In sehr vielen Repos.</p></details>
          <details><summary>Warum ist meine Cloud-Rechnung bei 38.000 €?</summary><p>Thinking is expensive. That's why we do it for you.</p></details>
          <details><summary>Wer hat diesen PR reviewed?</summary><p>Ein anderer Agent. Er war sehr überzeugt.</p></details>
          <details><summary>Wer hat eigentlich meine Codebase geschrieben?</summary><p class="serif">Gute Frage. Wir haben gehofft, du weißt es.</p></details>
        </div>
      </div>
    </section>

    <!-- CONTACT --------------------------------------------------------- -->
    <section id="contact">
      <div class="wrap center">
        <p class="eyebrow">Contact</p>
        <h2 class="serif">Still have questions?<br />Wir haben schon geantwortet.</h2>
        <form class="form" style="text-align:left" onsubmit="return false">
          <label>Your name<input type="text" placeholder="we already have your git config" /></label>
          <label>Message<textarea placeholder="Tell us what you're afraid to deploy."></textarea></label>
          <div><a class="btn btn-primary" href="#takeover">Let it ship</a></div>
        </form>
      </div>
    </section>

    <div class="void"><p>It's okay. You don't have to read the code anymore.</p></div>

    <Takeover />
  </main>

  <script>
    // Hero: "Last deploy" zählt hoch, wird aber ständig zurückgesetzt.
    const ld = document.getElementById('last-deploy')!;
    let s = 3;
    setInterval(() => { s = Math.random() < 0.25 ? 0 : s + 1; ld.textContent = `${s}s ago`; }, 1000);

    // Stats: Codezeilen wachsen unaufhörlich.
    const loc = document.getElementById('loc')!;
    let n = 1284992;
    setInterval(() => { n += Math.floor(Math.random() * 900); loc.textContent = n.toLocaleString('de-DE'); }, 700);

    // Numbers: Uhrzeit, verstrichene Zeit, Plattform. Alles lokal, nichts wird gesendet.
    const clock = document.getElementById('clock')!;
    const spent = document.getElementById('spent')!;
    const whisper = document.getElementById('whisper')!;
    const t0 = Date.now();
    const tick = () => {
      clock.textContent = new Date().toLocaleTimeString('de-DE');
      spent.textContent = `${Math.floor((Date.now() - t0) / 1000)}s`;
    };
    tick();
    setInterval(tick, 1000);

    const ua = navigator.userAgent;
    const os = /Mac/.test(ua) ? 'einem Mac' : /Win/.test(ua) ? 'Windows' : /Android/.test(ua) ? 'Android' : /iPhone|iPad/.test(ua) ? 'iOS' : /Linux/.test(ua) ? 'Linux' : 'irgendwas';
    const late = new Date().getHours() >= 22 || new Date().getHours() < 5;
    let shown = false;
    new IntersectionObserver(([e]) => {
      if (!e.isIntersecting || shown) return;
      shown = true;
      setTimeout(() => {
        whisper.innerHTML = `Du bist auf ${os}${late ? ', und es ist spät' : ''}. Nice setup. <span class="serif">Ist das ein Senior Dev hinter dir?</span>`;
      }, 2500);
    }, { threshold: 0.6 }).observe(whisper);
  </script>
</Base>
