---
import '../styles/global.css';
import type { Dict } from '../i18n/en';

interface Props {
  lang: 'en' | 'de';
  meta: Dict['meta'];
}
const { lang, meta } = Astro.props;

// BASE_URL endet nicht immer auf "/" – deshalb zusammensetzen statt anhängen.
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const favicon = `${base}/favicon.svg`;

// Absolute Adressen für Suchmaschinen und Link-Vorschauen (SITE + BASE kommen aus dem Pages-Workflow).
const root = new URL(`${base}/`, Astro.site);
const urls = { en: root.href, de: new URL('de/', root).href };
const canonical = urls[lang];
const image = new URL(`og-${lang}.png`, root).href;
const otherLocale = lang === 'de' ? 'en_US' : 'de_DE';

// Strukturierte Daten: was die Seite ist und wer dahintersteht. "<" escapen, damit nichts ausbricht.
const jsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: meta.title,
  description: meta.description,
  url: canonical,
  inLanguage: lang,
  genre: 'Satire',
  keywords: 'vibe coding, agentic engineering, AI coding, KI, LinkedIn, satire',
  image,
  isPartOf: { '@type': 'WebSite', name: 'Vibely', url: urls.en },
  author: { '@type': 'Organization', name: 'Lupus Malus Deviant Development', url: 'https://lupusmalus.dev/' },
}).replace(/</g, '\\u003c');
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{meta.title}</title>
    <meta name="description" content={meta.description} />
    <meta name="author" content="Lupus Malus Deviant Development" />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <meta name="theme-color" content="#6d4aff" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="en" href={urls.en} />
    <link rel="alternate" hreflang="de" href={urls.de} />
    <link rel="alternate" hreflang="x-default" href={urls.en} />

    <!-- Link-Vorschau: bleibt in der Rolle (siehe meta.og* in den Wörterbüchern). -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Vibely" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={meta.ogTitle} />
    <meta property="og:description" content={meta.ogDescription} />
    <meta property="og:locale" content={meta.locale} />
    <meta property="og:locale:alternate" content={otherLocale} />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={meta.ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={meta.ogTitle} />
    <meta name="twitter:description" content={meta.ogDescription} />
    <meta name="twitter:image" content={image} />

    <script type="application/ld+json" set:html={jsonLd} />
    <link rel="sitemap" type="application/xml" href={`${base}/sitemap.xml`} />

    <link rel="icon" type="image/svg+xml" href={favicon} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=EB+Garamond:ital,wght@0,500;1,500&family=Inter:wght@400;600&family=JetBrains+Mono:wght@400;700&family=Poppins:wght@600;700&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap"
    />
  </head>
  <body>
    <slot />
  </body>
</html>
