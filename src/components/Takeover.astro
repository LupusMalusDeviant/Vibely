---
// Der ernste Teil am Ende, danach die echte Werbung für lupusmalus.dev.
import type { Dict } from '../i18n/en';
interface Props { t: Dict['takeover']; pitch: Dict['pitch']; foot: Dict['foot'] }
const { t, pitch, foot } = Astro.props;
const [b0, b1, b2, b3, b4] = t.body;
---
<section id="takeover" class="takeover">
  <div class="wrap">
    <p class="sig"><span class="r">//</span> {t.sig[0]} — <b>/dev/wolves</b> {t.sig[1]}</p>

    <h2 class="glitch" data-text={t.h2}>{t.h2}</h2>

    <p class="t-lead">{t.lead}</p>
    <p>{b0}<em>{b1}</em>{b2}<em>{b3}</em>{b4}</p>

    <div class="vs" role="table" aria-label={`${t.head[0]} / ${t.head[1]}`}>
      <div class="vs-head" role="row">
        <span role="columnheader">{t.head[0]}</span>
        <span role="columnheader">{t.head[1]}</span>
      </div>
      {t.rows.map(([a, b]) => (
        <div class="vs-row" role="row">
          <span role="cell" class="a">{a}</span>
          <span role="cell" class="b">{b}</span>
        </div>
      ))}
    </div>

    <h3>{t.principlesTitle}</h3>
    <ol class="principles">
      {t.principles.map(([head, text]) => <li><b>{head}</b> {text}</li>)}
    </ol>

    <p class="closing">{t.closing[0]} <span class="hl">{t.closing[1]}</span></p>

    <!-- Echte Werbung: der Mensch hinter den Wölfen -->
    <div class="pitch" id="pitch">
      <p class="sig">{pitch.sig}</p>
      <h2>{pitch.h2}</h2>
      {pitch.body.map((p) => <p>{p}</p>)}
      <h3>{pitch.howTitle}</h3>
      <ul>{pitch.how.map((h) => <li>{h}</li>)}</ul>
      <a class="pitch-cta" href="https://lupusmalus.dev">{pitch.cta}</a>
      <p class="pitch-small">{pitch.small}</p>
    </div>

    <footer class="t-foot">
      <p>{foot[0]}</p>
      <p>{foot[1]} <span class="r">♥</span> <b>/dev/wolves</b> · {foot[2]} <a href="https://lupusmalus.dev">lupusmalusdeviant</a> {foot[3]}</p>
      <p><a href="#top" id="restore">{foot[4]}</a> · <a href="#top">{foot[5]}</a></p>
    </footer>
  </div>
</section>

<style>
  .takeover {
    background: #070a08; color: #c9f5d6; font-family: var(--mono); font-size: 15px; line-height: 1.7;
    padding: 120px 0 80px; position: relative; overflow: hidden;
  }
  .takeover::before {
    content: ''; position: absolute; inset: 0; pointer-events: none;
    background: repeating-linear-gradient(0deg, rgba(57,255,136,.035) 0 1px, transparent 1px 3px);
  }
  .takeover .wrap { position: relative; }
  .sig { color: #6fae84; font-size: 12.5px; letter-spacing: .06em; }
  .sig b, .t-foot b { color: #fff; }
  .r { color: #ff3b5c; }
  .takeover h2 { font-family: var(--mono); color: #39ff88; font-size: clamp(28px, 6vw, 46px); letter-spacing: -0.02em; margin: 18px 0 26px; }
  .takeover h3 { font-family: var(--mono); color: #39ff88; font-size: 15px; margin: 56px 0 14px; }
  .t-lead { font-size: 18px; color: #fff; }
  .takeover em { color: #39ff88; font-style: normal; }

  .glitch { position: relative; }
  .glitch::before, .glitch::after { content: attr(data-text); position: absolute; inset: 0; pointer-events: none; }
  .glitch::before { color: #ff3b5c; animation: g1 3.2s infinite steps(1); clip-path: inset(0 0 60% 0); }
  .glitch::after { color: #4ad6ff; animation: g2 2.7s infinite steps(1); clip-path: inset(55% 0 0 0); }
  @keyframes g1 { 0%, 92% { transform: none; opacity: 0; } 93% { transform: translate(-3px, -1px); opacity: .8; } 96% { transform: translate(2px, 1px); opacity: .8; } }
  @keyframes g2 { 0%, 90% { transform: none; opacity: 0; } 91% { transform: translate(3px, 1px); opacity: .8; } 95% { transform: translate(-2px, 0); opacity: .8; } }
  @media (prefers-reduced-motion: reduce) { .glitch::before, .glitch::after { display: none; } }

  .vs { margin-top: 40px; border: 1px solid #1d3a26; border-radius: 10px; overflow: hidden; }
  .vs-head, .vs-row { display: grid; grid-template-columns: 1fr 1fr; }
  .vs-head span { padding: 10px 16px; font-size: 12px; letter-spacing: .12em; text-transform: uppercase; background: #0f1912; }
  .vs-head span:first-child { color: #ff6b81; }
  .vs-head span:last-child { color: #39ff88; }
  .vs-row span { padding: 12px 16px; border-top: 1px solid #1d3a26; font-size: 14px; }
  .vs-row .a { color: #8a9a8f; text-decoration: line-through; text-decoration-color: rgba(255,59,92,.6); }
  .vs-row .b { color: #e6fff0; border-left: 1px solid #1d3a26; }

  .principles { padding-left: 22px; margin: 0; }
  .principles li { margin: 0 0 12px; }
  .principles b { color: #fff; }

  .closing { font-size: clamp(26px, 5vw, 38px); font-weight: 700; color: #fff; margin: 64px 0 0; letter-spacing: -0.02em; }
  .hl { background: #39ff88; color: #070a08; padding: 0 8px; }

  .pitch {
    margin-top: 110px; padding: 34px 30px; border: 1px solid #39ff88; border-radius: 14px;
    background: linear-gradient(160deg, rgba(57,255,136,.08), rgba(57,255,136,0) 60%);
    font-family: var(--sans); font-size: 17px; color: #e6fff0;
  }
  .pitch .sig { font-family: var(--mono); margin: 0; }
  .pitch h2 { font-family: var(--sans); color: #fff; font-weight: 800; font-size: clamp(26px, 5vw, 36px); margin: 14px 0 20px; }
  .pitch h3 { font-family: var(--mono); margin: 30px 0 10px; }
  .pitch ul { padding: 0; margin: 0 0 30px; list-style: none; }
  .pitch li { padding: 6px 0 6px 26px; position: relative; }
  .pitch li::before { content: '▸'; position: absolute; left: 4px; color: #39ff88; }
  .pitch-cta {
    display: inline-block; background: #39ff88; color: #070a08; font: 700 17px var(--mono);
    padding: 14px 24px; border-radius: 8px; text-decoration: none; transition: transform .15s;
  }
  .pitch-cta:hover { transform: translateY(-2px); }
  .pitch-small { font-family: var(--mono); font-size: 13px; color: #6fae84; margin: 14px 0 0; }

  .t-foot { margin-top: 80px; padding-top: 24px; border-top: 1px solid #1d3a26; font-size: 13px; color: #6fae84; }
  .t-foot p { margin: 4px 0; }
  .t-foot a { color: #39ff88; }

  @media (max-width: 560px) {
    .vs-head, .vs-row { grid-template-columns: 1fr; }
    .vs-head span:last-child { display: none; }
    .vs-row .b { border-left: 0; border-top: 1px dashed #1d3a26; }
    .vs-row .b::before { content: '→ '; color: #39ff88; }
    .pitch { padding: 26px 20px; }
  }
</style>

<script>
  // "Kontext wiederherstellen" = die komprimierte Seite neu laden, oben beginnend.
  document.getElementById('restore')?.addEventListener('click', (e) => {
    e.preventDefault();
    history.scrollRestoration = 'manual';
    location.reload();
  });
</script>
