---
// Randnotiz von /dev/wolves, die sich beim Sichtbarwerden eintippt.
// Steht schon vor dem Hack auf der Seite: Die Wölfe sind "seit dem Hero in den Wänden".
// stage 1: sieht aus wie ein vergessener Code-Kommentar. stage 2: dunkle Notiz, noch gerade.
// stage 3 (nach dem Hack): schief, rot, unübersehbar.
interface Props { prefix: string; text: string; align?: 'left' | 'right'; stage?: 1 | 2 | 3 }
const { prefix, text, align = 'right', stage = 3 } = Astro.props;
---
<aside class={`wolfnote ${align} s${stage}`} data-text={text}>
  <span class="wn-prefix">{prefix}</span> <span class="wn-text">{text}</span>
</aside>

<style>
  .wolfnote {
    display: block; width: fit-content; max-width: min(420px, 100%);
    margin: 14px 0 0; padding: 8px 12px; text-align: left;
    font: 12.5px/1.45 var(--mono); color: var(--wolf); background: var(--wolf-bg);
    border: 1px solid var(--wolf-line); border-radius: 6px; transform: rotate(-1.2deg);
    box-shadow: 0 8px 20px -10px rgba(0,0,0,.45);
  }
  .wolfnote.right { margin-left: auto; transform: rotate(1.2deg); }
  .wn-prefix { color: var(--wolf-dim); }
  .wolfnote.s1 {
    color: var(--muted); background: transparent; border: 1px dashed var(--line);
    box-shadow: none; transform: none; font-size: 12px;
  }
  .wolfnote.s1 .wn-prefix { color: var(--muted); }
  .wolfnote.s2 { transform: none; box-shadow: 0 4px 12px -8px rgba(0,0,0,.4); }
</style>

<script>
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const notes = document.querySelectorAll<HTMLElement>('.wolfnote');
  if (!reduce) {
    const io = new IntersectionObserver((entries) => {
      for (const e of entries) {
        if (!e.isIntersecting) continue;
        io.unobserve(e.target);
        const el = e.target.querySelector<HTMLElement>('.wn-text')!;
        const full = (e.target as HTMLElement).dataset.text!;
        let n = 0;
        const tick = () => {
          el.textContent = full.slice(0, ++n) + (n < full.length ? '▌' : '');
          if (n < full.length) setTimeout(tick, 28 + Math.random() * 40);
        };
        el.textContent = '▌';
        setTimeout(tick, 500);
      }
    }, { threshold: 0.9 });
    notes.forEach((n) => io.observe(n));
  }
</script>
