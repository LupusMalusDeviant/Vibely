---
// "Live-Demo": ein Agent behebt einen Tippfehler. Startet, sobald sichtbar.
import type { Dict } from '../i18n/en';
interface Props { t: Dict['demo'] }
const { t } = Astro.props;
---
<section id="demo" data-summary={t.summary}>
  <div class="wrap center">
    <p class="eyebrow">{t.eyebrow}</p>
    <h2>{t.h2}</h2>
    <p class="lead">{t.lead}</p>
    <div class="demo-win">
      <div class="demo-bar"><span></span><span></span><span></span><em>vibely-agent — prod</em></div>
      <pre id="demo-out" data-lines={JSON.stringify(t.lines)}></pre>
      <span class="demo-mark">VIBELY AUTONOMY™</span>
    </div>
    <p class="fine">{t.caption}</p>
  </div>
</section>

<style>
  .demo-win {
    margin-top: 40px; text-align: left; background: #111017; color: #e9e6f3; border-radius: 18px;
    box-shadow: 0 30px 60px -30px rgba(30, 10, 80, .55); overflow: hidden; position: relative;
  }
  .demo-bar { display: flex; gap: 6px; align-items: center; padding: 12px 14px; border-bottom: 1px solid #262333; }
  .demo-bar span { width: 10px; height: 10px; border-radius: 50%; background: #3a3648; }
  .demo-bar em { font: 12px var(--mono); font-style: normal; color: #8b86a0; margin-left: 8px; }
  pre { margin: 0; padding: 18px; font: 13px/1.6 var(--mono); min-height: 430px; white-space: pre-wrap; }
  pre :global(.dim) { color: #8b86a0; }
  pre :global(.ok) { color: #59e39b; }
  pre :global(.warn) { color: #ffcc66; }
  pre :global(.bad) { color: #ff6b81; }
  pre :global(.wolf) { color: #39ff88; background: rgba(57,255,136,.08); }
  .demo-mark { position: absolute; right: 16px; bottom: 12px; font: 700 11px var(--mono); color: #4a4560; letter-spacing: .1em; }
  @media (max-width: 560px) { pre { font-size: 12px; min-height: 600px; } }
</style>

<script>
  const out = document.getElementById('demo-out');
  if (out) {
    const lines: Array<[string, string]> = JSON.parse(out.dataset.lines!);
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const html = (t: string, c: string) => `<span class="${c}">${t.replace(/&/g, '&amp;').replace(/</g, '&lt;')}</span>`;
    let started = false;
    const run = () => {
      if (started) return;
      started = true;
      if (reduce) { out.innerHTML = lines.map(([t, c]) => html(t, c)).join('\n'); return; }
      let i = 0;
      const next = () => {
        if (i >= lines.length || !out.isConnected) return;
        out.innerHTML += (i ? '\n' : '') + html(lines[i][0], lines[i][1]);
        i++;
        setTimeout(next, 650 + Math.random() * 600);
      };
      next();
    };
    new IntersectionObserver(([e]) => e.isIntersecting && run(), { threshold: 0.4 }).observe(out);
  }
</script>
