---
// Der Hack: Bildschirmfüllende Unterbrechung nach etwa 40 % der Seite.
// Ab hier trägt <body> dauerhaft die Klasse "breached" und das Ereignis "breach" wird ausgelöst.
interface Props { lines: Array<[string, string]> }
const { lines } = Astro.props;
---
<section id="intrusion" class="intrusion">
  <div class="wrap">
    <pre id="intrusion-out" aria-hidden="true"></pre>
    <div class="sr-only">{lines.map(([t]) => <p>{t.replace(/^> /, '')}</p>)}</div>
  </div>
  <script type="application/json" id="intrusion-lines" set:html={JSON.stringify(lines).replace(/</g, '\\u003c')} />
</section>

<style>
  .intrusion {
    background: var(--wolf-bg); color: var(--wolf-text); min-height: 100vh; display: flex; align-items: center;
    position: relative; overflow: hidden;
  }
  .intrusion::before {
    content: ''; position: absolute; inset: 0; pointer-events: none;
    background: repeating-linear-gradient(0deg, rgba(220,38,38,.05) 0 1px, transparent 1px 3px);
  }
  .intrusion .wrap { width: 100%; position: relative; }
  pre { margin: 0; font: clamp(15px, 2.6vw, 21px)/1.7 var(--mono); white-space: pre-wrap; min-height: 14em; }
  pre :global(.r) { color: var(--wolf-accent); font-weight: 700; }
  pre :global(.w) { color: #fff; background: var(--wolf-deep); padding: 0 4px; }
  .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  .intrusion.flash { animation: flash .6s steps(2) 2; }
  @keyframes flash { 50% { filter: invert(1) hue-rotate(90deg); transform: translateX(-6px); } }
  @media (prefers-reduced-motion: reduce) { .intrusion.flash { animation: none; } }
</style>

<script>
  const sec = document.getElementById('intrusion')!;
  const out = document.getElementById('intrusion-out')!;
  const lines: Array<[string, string]> = JSON.parse(document.getElementById('intrusion-lines')!.textContent!);
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const esc = (s: string) => s.replace(/&/g, '&amp;').replace(/</g, '&lt;');
  const wrap = (t: string, c: string) => (c ? `<span class="${c}">${esc(t)}</span>` : esc(t));

  let done = false;
  const run = () => {
    if (done) return;
    done = true;
    document.body.classList.add('breached');
    window.dispatchEvent(new Event('breach'));
    if (reduce) { out.innerHTML = lines.map(([t, c]) => wrap(t, c)).join('\n'); return; }
    sec.classList.add('flash');
    const html: string[] = [];
    let i = 0;
    const nextLine = () => {
      if (i >= lines.length) return;
      const [text, cls] = lines[i++];
      let n = 0;
      html.push('');
      const tick = () => {
        n += 1 + Math.floor(Math.random() * 2);
        html[html.length - 1] = wrap(text.slice(0, n), cls);
        out.innerHTML = html.join('\n') + '▌';
        if (n < text.length) setTimeout(tick, 22 + Math.random() * 30);
        else setTimeout(nextLine, 650);
      };
      tick();
    };
    setTimeout(nextLine, 500);
  };
  new IntersectionObserver(([e]) => e.isIntersecting && run(), { threshold: 0.35 }).observe(sec);
</script>
