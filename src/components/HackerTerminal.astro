---
// Hollywood-Hacker-Terminal unten links plus Defacement-Plakette oben.
// Sichtbar, aber nicht dominant. Texte kommen aus dem i18n-JSON der Seite.
interface Props { badge: string; pwned: string }
const { badge, pwned } = Astro.props;
---
<a class="defaced" href="#takeover">
  <span class="blink" aria-hidden="true">●</span> {badge} <b>/dev/wolves</b>
</a>

<!-- Lauert zunächst unsichtbar; taucht ab der Kamera-Freigabe eingeklappt auf, nach dem Hack offen. -->
<aside class="hterm lurk min" id="hterm" aria-hidden="true" inert>
  <div class="hterm-bar">
    <span></span><span></span><span></span>
    <em>wolf@pack:~ <span class="pwn">· {pwned} /dev/wolves</span></em>
    <button type="button" class="hterm-min" tabindex="-1">_</button>
  </div>
  <pre class="hterm-out" id="hterm-out" tabindex="-1"></pre>
</aside>

<style>
  .defaced {
    position: fixed; top: 84px; right: 14px; z-index: 30;
    font: 11.5px/1 var(--mono); color: var(--wolf); background: var(--wolf-bg);
    border: 1px solid var(--wolf-line); padding: 7px 10px; border-radius: 6px;
    text-decoration: none; opacity: .88; transform: rotate(1.5deg);
    box-shadow: 0 6px 18px -8px rgba(0,0,0,.5);
  }
  .defaced:hover { opacity: 1; }
  /* Die Plakette erscheint erst mit dem Hack. */
  :global(body:not(.breached)) .defaced { display: none; }
  .defaced b { color: #fff; }
  .blink { color: var(--wolf-accent); animation: blink 1.1s steps(1) infinite; }
  @keyframes blink { 50% { opacity: 0; } }

  .hterm {
    position: fixed; left: 14px; bottom: 14px; z-index: 30; width: 330px; max-width: calc(100vw - 28px);
    background: rgba(10, 10, 10, .92); color: var(--wolf); border: 1px solid var(--wolf-line); border-radius: 10px;
    font: 11.5px/1.45 var(--mono); box-shadow: 0 12px 30px -12px rgba(0,0,0,.6);
    transition: opacity .4s, transform .4s;
  }
  .hterm.min .hterm-out { display: none; }
  .hterm.gone, .hterm.lurk { opacity: 0; transform: translateY(20px); pointer-events: none; }
  .hterm.lurk { visibility: hidden; }
  .hterm-bar { display: flex; align-items: center; gap: 5px; padding: 6px 8px; border-bottom: 1px solid var(--wolf-line); }
  .hterm-bar > span { width: 8px; height: 8px; border-radius: 50%; background: var(--wolf-line); flex: none; }
  .hterm-bar em { font-style: normal; color: var(--wolf-dim); margin-left: 6px; flex: 1; }
  .hterm-min { background: none; border: 0; color: var(--wolf-dim); font: inherit; cursor: pointer; padding: 0 4px; }
  .hterm-out { margin: 0; padding: 8px 10px; height: 124px; overflow: hidden; white-space: pre-wrap; word-break: break-word; }
  .hterm-out.static { overflow-y: auto; }
  .hterm-out :global(.r) { color: var(--wolf-accent); }
  .hterm-out :global(.w) { color: #fff; }
  .pwn { display: none; color: #fff; }

  @media (max-width: 560px) {
    .hterm { width: 240px; font-size: 10px; }
    .hterm-out { height: 86px; }
    .defaced { display: none; }
    .pwn { display: inline; }
  }
</style>

<script>
  const i18n = JSON.parse(document.getElementById('i18n')!.textContent!);
  const out = document.getElementById('hterm-out')!;
  const term = document.getElementById('hterm')!;
  // Im festen Modus (reduzierte Bewegung) beginnt man oben zu lesen und scrollt selbst.
  const toLatest = () => { if (!out.classList.contains('static')) out.scrollTop = out.scrollHeight; };
  // Beim Aufklappen war die Ausgabe versteckt und hatte keine Höhe: danach zur neuesten Zeile.
  term.querySelector('.hterm-min')!.addEventListener('click', () => { term.classList.toggle('min'); toLatest(); });
  // Stufe 2: ab der Kamera-Freigabe taucht das Terminal eingeklappt auf (Markup startet mit "lurk min").
  const reveal = () => { if (term.classList.contains('lurk')) { term.classList.remove('lurk'); term.removeAttribute('inert'); } };
  const perm = document.getElementById('permission');
  if (perm) new IntersectionObserver(([e], io) => { if (e.isIntersecting) { reveal(); io.disconnect(); } }, { threshold: 0.2 }).observe(perm);

  // Live verfolgen: Die Einstellung kann sich ändern, während die Seite offen ist.
  const reduceMq = window.matchMedia('(prefers-reduced-motion: reduce)');
  const bar = (p: number) => '[' + '█'.repeat(Math.round(p / 10)) + '░'.repeat(10 - Math.round(p / 10)) + '] ' + p + '%';
  const esc = (s: string) => s.replace(/[&<>]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;' })[c]!);

  const prep = (list: Array<[string, string?]>): Array<[string, string?]> =>
    list.map(([t, c]) => [t.replace(/%BAR(\d+)%/, (_: string, p: string) => bar(Number(p))), c]);
  let script = prep(i18n.hacker);
  let i = 0;
  // Nach dem Hack: Angriffsmodus. Die Wölfe arbeiten jetzt sichtbar am Agent.
  window.addEventListener('breach', () => {
    script = prep(i18n.hackerBreach); i = 0;
    reveal();
    if (!window.matchMedia('(max-width: 560px)').matches) term.classList.remove('min');
    if (reduceMq.matches) showStatic();
    toLatest();
  });

  const lines: string[] = [];
  // Umbrochene Zeilen sind höher als das Fenster: immer bis zur neuesten Zeile scrollen.
  const render = () => { out.innerHTML = lines.slice(-8).join('\n') + '<span class="w">▌</span>'; toLatest(); };
  const wrap = (t: string, c?: string) => (c ? `<span class="${c}">${esc(t)}</span>` : esc(t));

  // Jeder Start des Tippens bekommt eine Nummer. Ändert sich der Modus, laufen alte Zeitgeber ins Leere.
  let run = 0;
  let timer: number | undefined;
  const later = (fn: () => void, ms: number, id: number) => { timer = window.setTimeout(() => { if (id === run) fn(); }, ms); };

  // Reduzierte Bewegung: kein Tippen, sondern das ganze aktuelle Skript auf einmal, im Fenster scrollbar.
  function showStatic() {
    run++; clearTimeout(timer);
    out.classList.add('static');
    out.innerHTML = script.map(([t, c]) => wrap(t, c)).join('\n');
    out.scrollTop = 0;
  }

  function startTyping(delay: number) {
    const id = ++run; clearTimeout(timer);
    out.classList.remove('static');
    lines.length = 0;
    const typeNext = () => {
      const [text, cls] = script[i++ % script.length];
      let n = 0;
      lines.push('');
      const tick = () => {
        n += 1 + Math.floor(Math.random() * 3);
        lines[lines.length - 1] = wrap(text.slice(0, n), cls);
        render();
        if (n < text.length) later(tick, 18 + Math.random() * 40, id);
        else later(typeNext, text.startsWith('$') ? 500 : 1100 + Math.random() * 900, id);
      };
      tick();
    };
    later(typeNext, delay, id);
  }

  if (reduceMq.matches) showStatic(); else startTyping(1800);
  reduceMq.addEventListener('change', () => (reduceMq.matches ? showStatic() : startTyping(300)));

  // Im Übernahme-Abschnitt ist alles Terminal: Mini-Terminal weg, Navigation "gehackt".
  const takeover = document.getElementById('takeover');
  if (takeover) {
    new IntersectionObserver(([e]) => {
      term.classList.toggle('gone', e.isIntersecting);
      // Unsichtbar heißt auch: nicht fokussierbar, nicht klickbar.
      term.toggleAttribute('inert', e.isIntersecting || term.classList.contains('lurk'));
      document.body.classList.toggle('pwned', e.isIntersecting);
    }, { threshold: 0.05 }).observe(takeover);
  }
  // Während der Unterbrechung gehört auch die Navigation den Wölfen.
  const intrusion = document.getElementById('intrusion');
  if (intrusion) {
    new IntersectionObserver(([e]) => document.body.classList.toggle('pwned-i', e.isIntersecting), { threshold: 0.3 }).observe(intrusion);
  }
</script>
