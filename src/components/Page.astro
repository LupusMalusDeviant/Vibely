---
// Die komplette Seite, einmal pro Sprache gerendert (pages/index.astro = EN, pages/de/index.astro = DE).
import Base from '../layouts/Base.astro';
import HackerTerminal from './HackerTerminal.astro';
import AgentChat from './AgentChat.astro';
import Demo from './Demo.astro';
import Takeover from './Takeover.astro';
import Thought from './Thought.astro';
import { en, type Dict } from '../i18n/en';
import { de } from '../i18n/de';

interface Props { lang: 'en' | 'de' }
const t: Dict = Astro.props.lang === 'de' ? de : en;

// Relative Links, damit die Seite auch unter einem Unterpfad funktioniert.
const switchHref = t.lang === 'de' ? '../index.html' : 'de/index.html';
const alternate = { lang: t.lang === 'de' ? 'en' : 'de', href: switchHref };

// Texte für die Client-Skripte. "<" escapen, damit nichts aus dem JSON-Block ausbricht.
const clientJson = JSON.stringify({
  ...t.client,
  compact: t.compact,
  pricing: { moods: t.pricing.moods, locale: t.pricing.locale },
}).replace(/</g, '\\u003c');

const logo = `<svg viewBox="0 0 32 32" aria-hidden="true"><rect width="32" height="32" rx="8" fill="url(#lg)"/><defs><linearGradient id="lg" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#6d4aff"/><stop offset="1" stop-color="#c04aff"/></linearGradient></defs><path d="M9 10l7 13 7-13" fill="none" stroke="#fff" stroke-width="3.2" stroke-linecap="round" stroke-linejoin="round"/></svg>`;
const feedMinutes = [2, 3, 5, 6, 8, 9, 11, 14];
---
<Base lang={t.lang} title={t.meta.title} description={t.meta.description} alternate={alternate}>
  <script type="application/json" id="i18n" set:html={clientJson} />
  <span id="top"></span>
  <HackerTerminal badge={t.client.badge} pwned={t.client.pwned} />
  <AgentChat />

  <nav class="nav">
    <div class="wrap">
      <a class="logo" href="#top"><Fragment set:html={logo} />Vibely</a>
      <div class="nav-right">
        <a class="lang" href={switchHref} hreflang={alternate.lang} aria-label={t.nav.switchLabel}>{t.nav.switchShort}</a>
        <a class="btn btn-primary" href="#pricing">{t.nav.cta}</a>
      </div>
    </div>
    <div class="ctx-bar" aria-hidden="true"><span id="ctx-fill"></span></div>
  </nav>
  <div class="ctx-label" id="ctx-label" aria-hidden="true">{t.client.context} 3% · 6k / 200k</div>

  <main>
    <!-- HERO: Prompt-Feld, in das die Autovervollständigung hineinredet -->
    <section class="hero" data-summary={t.hero.summary}>
      <div class="wrap">
        <span class="pill"><b>{t.hero.pill[0]}</b> {t.hero.pill[1]}</span>
        <h1>{t.hero.h1[0]}<br /><span class="grad">{t.hero.h1[1]}</span></h1>
        <p class="lead">{t.hero.lead}</p>

        <div class="prompt" id="prompt" data-typed={t.hero.promptTyped} data-ghost={t.hero.promptGhost}>
          <label>{t.hero.promptLabel}</label>
          <div class="prompt-field">
            <span id="prompt-typed"></span><span id="prompt-ghost" class="ghost"></span><span class="caret" aria-hidden="true"></span>
          </div>
          <div class="prompt-foot">
            <span class="accepted" id="prompt-accepted" hidden>⇥ {t.hero.promptAccepted}</span>
            <a class="btn btn-primary" href="#demo">{t.hero.promptButton}</a>
          </div>
        </div>
        <div class="chips">{t.hero.chips.map((c) => <span class="chip">{c}</span>)}</div>
        <p class="fine">{t.hero.fine}</p>
      </div>
    </section>

    <!-- LAUNCH-FEED -->
    <section id="feed" class="feed-sec" data-summary={t.feed.summary}>
      <div class="wrap">
        <p class="eyebrow"><span class="live-dot"></span>{t.feed.eyebrow}</p>
        <h2>{t.feed.h2}</h2>
        <ul class="feed" id="feed-list">
          {t.feed.items.map(([who, what, cls], i) => (
            <li class={cls}><b>{who}</b> {what} <time>· {t.feed.ago(feedMinutes[i])}</time></li>
          ))}
        </ul>
      </div>
    </section>

    <!-- BENCHMARKS -->
    <section id="bench" data-summary={t.bench.summary}>
      <div class="wrap center">
        <p class="eyebrow">{t.bench.eyebrow}</p>
        <h2>{t.bench.h2}</h2>
        <div class="bench">
          <div class="legend"><span class="sw sw-a"></span>{t.bench.legend[0]}<span class="sw sw-b"></span>{t.bench.legend[1]}</div>
          {t.bench.rows.map(([label, a, av, b, bv]) => (
            <div class="bench-row">
              <div class="bench-label">{label}</div>
              <div class={`bar a${a >= 70 ? ' in' : ''}`} style={`--w:${a}%`}><span>{av}</span></div>
              <div class={`bar b${b >= 70 ? ' in' : ''}`} style={`--w:${b}%`}><span>{bv}</span></div>
            </div>
          ))}
          <p class="footnote">{t.bench.foot}</p>
        </div>
        <Thought label={t.thought(2)} text={t.bench.thought} />
      </div>
    </section>

    <!-- FEATURES -->
    <section id="features" data-summary={t.features.summary}>
      <div class="wrap center">
        <p class="eyebrow">{t.features.eyebrow}</p>
        <h2>{t.features.h2[0]}<br />{t.features.h2[1]}</h2>
        <div class="cards grid2">
          {t.features.cards.map(([icon, title, text], i) => (
            <div class={'card' + (i === 3 ? ' tilt' : '')}><div class="icon">{icon}</div><h3>{title}</h3><p>{text}</p></div>
          ))}
        </div>
        <p class="footnote">{t.features.foot}</p>
        <Thought label={t.thought(4)} text={t.features.thought} />
      </div>
    </section>

    <Demo t={t.demo} />

    <!-- LINKEDIN-WAND -->
    <section id="social" data-summary={t.social.summary}>
      <div class="wrap center">
        <p class="eyebrow">{t.social.eyebrow}</p>
        <h2>{t.social.h2}</h2>
        <div class="cards">
          {t.social.posts.map((p, i) => (
            <article class={'post' + (i === 2 ? ' tilt' : '')}>
              <header>
                <div class="avatar" style={`background:${p.color}`}>{p.initials}</div>
                <div class="who"><b>{p.name}</b><small>{p.title}</small></div>
                {i < 2 && <span class="connect">{t.social.follow}</span>}
              </header>
              <p class="body">{p.body}</p>
              <div class="meta"><span>{p.meta[0]}</span><span>{p.meta[1]}</span></div>
              {p.note && <p class="note">{p.note}</p>}
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- VERSIONSHINWEISE -->
    <section id="changelog" data-summary={t.changelog.summary}>
      <div class="wrap">
        <p class="eyebrow">{t.changelog.eyebrow}</p>
        <h2>{t.changelog.h2}</h2>
        <ol class="changes">
          {t.changelog.entries.map(([v, text], i) => (
            <li class={i === t.changelog.entries.length - 1 ? 'last' : ''}>
              <span class="ver">v{v}</span><span class="txt">{text}</span><time>{t.changelog.ago[i]}</time>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- PREISRECHNER -->
    <section id="pricing" data-summary={t.pricing.summary}>
      <div class="wrap center">
        <p class="eyebrow">{t.pricing.eyebrow}</p>
        <h2>{t.pricing.h2}</h2>
        <p class="lead">{t.pricing.lead}</p>
        <div class="calc">
          <label for="features-range">{t.pricing.slider}: <b id="calc-n">3</b></label>
          <input type="range" id="features-range" min="1" max="50" value="3" />
          <div class="calc-out">
            <div><small>{t.pricing.tokens}</small><b id="calc-tokens">–</b></div>
            <div><small>{t.pricing.cost}</small><b id="calc-cost">–</b></div>
          </div>
          <p class="mood" id="calc-mood"></p>
          <ul class="breakdown">
            {t.pricing.breakdown.map(([label, pct]) => (
              <li><span>{label}</span><span class="bd-bar" style={`--w:${pct}%`}></span><b>{pct} %</b></li>
            ))}
          </ul>
          <a class="btn btn-primary" href="#faq">{t.pricing.cta}</a>
          <p class="fine">{t.pricing.fine}</p>
        </div>
        <Thought label={t.thought(1)} text={t.pricing.thought} />
      </div>
    </section>

    <!-- FAQ -->
    <section id="faq" data-summary={t.faq.summary}>
      <div class="wrap">
        <p class="eyebrow center">{t.faq.eyebrow}</p>
        <h2 class="center">{t.faq.h2}</h2>
        <div class="faq">
          {t.faq.items.map(([q, a], i) => (
            <details><summary>{q}</summary><p class={i === t.faq.items.length - 1 ? 'serif' : ''}>{a}</p></details>
          ))}
        </div>
      </div>
    </section>

    <!-- KONTEXT VOLL: der Agent komprimiert alles darüber zu einer Zusammenfassung -->
    <section id="compact" class="compact">
      <div class="wrap">
        <h2>{t.compact.h2}</h2>
        <p class="compact-status" id="compact-status">{t.compact.status}</p>
        <ul class="compact-list" id="compact-list"></ul>
      </div>
    </section>

    <Takeover t={t.takeover} />
  </main>

  <script>
    const i18n = JSON.parse(document.getElementById('i18n')!.textContent!);
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    // ---------- Hero: Nutzer tippt, die Autovervollständigung ergänzt "hilfreich" ----------
    const prompt = document.getElementById('prompt')!;
    const typedEl = document.getElementById('prompt-typed')!;
    const ghostEl = document.getElementById('prompt-ghost')!;
    const acceptedEl = document.getElementById('prompt-accepted')!;
    const typed = prompt.dataset.typed!;
    const ghost = prompt.dataset.ghost!;
    if (reduce) {
      typedEl.textContent = typed + ghost;
      acceptedEl.hidden = false;
    } else {
      let n = 0;
      const type = () => {
        typedEl.textContent = typed.slice(0, ++n);
        if (n < typed.length) return setTimeout(type, 70 + Math.random() * 60);
        setTimeout(() => {
          ghostEl.textContent = ghost;
          setTimeout(() => {
            ghostEl.textContent = '';
            typedEl.textContent = typed + ghost;
            acceptedEl.hidden = false;
          }, 1300);
        }, 500);
      };
      setTimeout(type, 900);
    }

    // ---------- Launch-Feed: der unterste Eintrag rutscht nach oben ----------
    const feed = document.getElementById('feed-list')!;
    if (!reduce) {
      setInterval(() => {
        if (!feed.isConnected || !feed.lastElementChild) return;
        const last = feed.lastElementChild as HTMLElement;
        feed.prepend(last);
        last.classList.add('fresh');
        setTimeout(() => last.classList.remove('fresh'), 1200);
      }, 2800);
    }

    // ---------- Gedanken: wer reinschaut, wird notiert ----------
    let openedThought = false;
    document.querySelectorAll('details.thought').forEach((d) =>
      d.addEventListener('toggle', () => { if ((d as HTMLDetailsElement).open) openedThought = true; }));

    // ---------- Preisrechner ----------
    const range = document.getElementById('features-range') as HTMLInputElement;
    const fmt = new Intl.NumberFormat(i18n.pricing.locale, { maximumFractionDigits: 0 });
    const money = new Intl.NumberFormat(i18n.pricing.locale, { style: 'currency', currency: 'EUR', maximumFractionDigits: 0 });
    let maxN = 3;
    let movedBack = false;
    const calc = () => {
      const n = Number(range.value);
      if (n > maxN) maxN = n;
      if (n < maxN) movedBack = true;
      const cost = 19 * Math.pow(n, 2.4);
      document.getElementById('calc-n')!.textContent = String(n);
      document.getElementById('calc-tokens')!.textContent = fmt.format(cost * 52000);
      document.getElementById('calc-cost')!.textContent = money.format(cost);
      const moods: string[] = i18n.pricing.moods;
      document.getElementById('calc-mood')!.textContent = moods[n <= 5 ? 0 : n <= 15 ? 1 : n <= 30 ? 2 : 3];
    };
    range.addEventListener('input', calc);
    calc();

    // ---------- Kontextfenster: füllt sich beim Scrollen ----------
    const label = document.getElementById('ctx-label')!;
    const fill = document.getElementById('ctx-fill')!;
    const compactSec = document.getElementById('compact')!;
    let compacted = false;
    const setCtx = (pct: number) => {
      label.textContent = `${i18n.context} ${pct}% · ${Math.round(pct * 2)}k / 200k`;
      fill.style.width = pct + '%';
      label.classList.toggle('hot', pct >= 80);
    };
    const onScroll = () => {
      if (compacted) return;
      const end = compactSec.offsetTop - window.innerHeight * 0.5;
      const p = Math.min(1, Math.max(0, window.scrollY / Math.max(1, end)));
      setCtx(Math.round(3 + p * 94));
    };
    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();

    // ---------- Komprimieren: alles darüber schrumpft auf eine Zeile ----------
    const list = document.getElementById('compact-list')!;
    const status = document.getElementById('compact-status')!;
    const c = i18n.compact;

    const compactPage = () => {
      compacted = true;
      label.textContent = i18n.compacting;
      label.classList.add('hot');
      document.querySelectorAll<HTMLElement>('main > section[data-summary]').forEach((sec) => sec.classList.add('fading'));

      setTimeout(() => {
        // Position des Abschnitts merken, damit die Seite beim Schrumpfen nicht springt.
        const before = compactSec.getBoundingClientRect().top;
        document.querySelectorAll<HTMLElement>('main > section[data-summary]').forEach((sec) => {
          const summary = sec.dataset.summary!;
          sec.className = 'compacted';
          sec.removeAttribute('id');
          sec.innerHTML = `<div class="wrap"><p><span class="tag">⟨${c.tag}⟩</span> </p></div>`;
          sec.querySelector('p')!.append(summary);
        });
        window.scrollBy(0, compactSec.getBoundingClientRect().top - before);

        setCtx(9);
        label.classList.remove('hot');
        status.textContent = c.done;

        const bullets: string[] = [...c.base];
        if (openedThought) bullets.push(c.openedThought);
        if (maxN !== 3) bullets.push(c.slider.replace('{n}', String(maxN)));
        if (movedBack) bullets.push(c.sliderBack);
        bullets.push(c.last);
        bullets.forEach((b, i) => setTimeout(() => {
          const li = document.createElement('li');
          li.textContent = b;
          if (i === bullets.length - 1) li.className = 'last';
          list.append(li);
        }, reduce ? 0 : 500 + i * 650));
      }, reduce ? 0 : 1600);
    };

    new IntersectionObserver(([e]) => {
      if (e.isIntersecting && !compacted) compactPage();
    }, { threshold: 0.5 }).observe(compactSec);
  </script>
</Base>
