---
// Der "hilfsbereite" Chat-Agent unten rechts. Meldet sich je nach Scrolltiefe –
// erst Sales, dann zunehmend zu aufmerksam. Keine echten Daten, alles gespielt.
---
<div class="agent" id="agent" role="status" aria-live="polite">
  <div class="agent-bubble" id="agent-bubble" hidden></div>
  <button type="button" class="agent-fab" id="agent-fab" aria-label="Vibely Agent">
    <svg viewBox="0 0 32 32" aria-hidden="true"><path d="M9 10l7 13 7-13" fill="none" stroke="#fff" stroke-width="3.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
  </button>
</div>

<style>
  .agent { position: fixed; right: 16px; bottom: 16px; z-index: 31; display: flex; flex-direction: column; align-items: flex-end; gap: 10px; }
  .agent-fab {
    width: 54px; height: 54px; border-radius: 50%; border: 0; cursor: pointer;
    background: linear-gradient(135deg, var(--brand), var(--brand-2)); box-shadow: 0 10px 26px -8px rgba(109,74,255,.8);
    display: grid; place-items: center;
  }
  .agent-fab svg { width: 24px; height: 24px; }
  .agent-bubble {
    max-width: 260px; background: #fff; border: 1px solid var(--line); border-radius: 16px 16px 4px 16px;
    padding: 12px 14px; font-size: 14px; box-shadow: var(--shadow); animation: pop .25s ease-out;
  }
  .agent-bubble.creepy { font-family: var(--serif); font-size: 16px; }
  @keyframes pop { from { opacity: 0; transform: translateY(6px); } }
  .agent.gone { display: none; }
  @media (max-width: 560px) { .agent-bubble { max-width: 200px; font-size: 13px; } }
</style>

<script>
  const bubble = document.getElementById('agent-bubble')!;
  const fab = document.getElementById('agent-fab')!;
  const agent = document.getElementById('agent')!;

  let hideTimer: number | undefined;
  function say(text: string, creepy = false, ms = 6500) {
    bubble.hidden = false;
    bubble.textContent = text;
    bubble.classList.toggle('creepy', creepy);
    bubble.style.animation = 'none';
    void bubble.offsetWidth;
    bubble.style.animation = '';
    clearTimeout(hideTimer);
    hideTimer = window.setTimeout(() => (bubble.hidden = true), ms);
  }

  // Nachrichten an Abschnitte gebunden: [id, text, creepy]
  const cues: Array<[string, string, boolean]> = [
    ['features', 'Hey 👋 Ich bin dein Vibely Agent. Soll ich dein MVP bauen? Dauert 11 Minuten.', false],
    ['day', 'Fun fact: Ich habe heute schon 34 PRs approved. Alle von mir. 🚀', false],
    ['testimonials', 'Chad hat übrigens auch so angefangen. Mit Scrollen.', false],
    ['security', 'Du liest das Kleingedruckte. Interessant. Das tun nur Senior Devs.', true],
    ['numbers', 'Du scrollst langsamer. Zweifelst du? Ich kann das refactoren.', true],
    ['pricing', 'Ich habe deine Repos schon geforkt. Nur zur Sicherheit.', true],
    ['team', 'Wir sind ein kleines Team. Ich. Und ich.', true],
    ['contact', 'Du musst nichts schreiben. Ich habe schon geantwortet. In deinem Namen.', true],
  ];
  const seen = new Set<string>();
  const io = new IntersectionObserver((entries) => {
    for (const e of entries) {
      if (!e.isIntersecting) continue;
      const cue = cues.find(([id]) => id === e.target.id);
      if (cue && !seen.has(cue[0])) {
        seen.add(cue[0]);
        say(cue[1], cue[2]);
      }
    }
  }, { threshold: 0.35 });
  cues.forEach(([id]) => { const el = document.getElementById(id); if (el) io.observe(el); });

  let clicks = 0;
  const replies = [
    'Wie kann ich helfen? Ich habe eine Vermutung.',
    'Dein Problem ist gelöst. Frag nicht, wie.',
    'Bitte nicht nochmal klicken. Ich arbeite.',
    'Du kannst mich nicht schließen. Ich bin Teil deines Stacks.',
  ];
  fab.addEventListener('click', () => say(replies[Math.min(clicks++, replies.length - 1)], clicks > 2));

  // Tab-Titel wechselt, wenn man den Tab verlässt.
  const original = document.title;
  document.addEventListener('visibilitychange', () => {
    document.title = document.hidden ? 'Komm zurück. Dein Agent hat weitergemacht.' : original;
  });

  const takeover = document.getElementById('takeover');
  if (takeover) {
    new IntersectionObserver(([e]) => agent.classList.toggle('gone', e.isIntersecting), { threshold: 0.05 }).observe(takeover);
  }
</script>
